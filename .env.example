# Copie este arquivo para ".env" (ou cole estas variáveis no editor de
# variáveis de ambiente do Portainer ao criar a Stack).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=horas_adicionais

JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# Origem do frontend, usada pelo backend para liberar CORS.
CLIENT_ORIGIN=http://localhost:8080

# Porta exposta pelo container do frontend (nginx) no host/Portainer.
HTTP_PORT=8080

# Usuário administrador criado pelo `npm run db:seed`.
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha
